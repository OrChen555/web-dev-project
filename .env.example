# Copy to .env and fill in. .env is never committed.
# The default URI matches the container started by npm run db:up.
PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/the-daily-web

# Signs the session cookie. Any long random string. No default on purpose:
# a default secret is a secret everybody already knows.
SESSION_SECRET=

# The administrator, created at startup if it is not there yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
