{
  "name": "the-daily-web",
  "version": "1.0.0",
  "private": true,
  "description": "A newsroom that files, subs and publishes copy",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:ui": "docker compose --profile tools up -d viewer",
    "db:ui:down": "docker compose stop viewer",
    "seed": "node scripts/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "connect-mongo": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-session": "^1.19.0",
    "mongoose": "^8.9.5"
  }
}
