<%- include('partials/top') %>

<%
  const day = new Date(story.publishedAt).toLocaleDateString('he-IL', { day: 'numeric', month: 'long', year: 'numeric' });
  const paragraphs = story.body.split(/\n{2,}/).map((p) => p.trim()).filter(Boolean);
%>

<article class="reading" data-article="<%= story.id %>">
  <nav class="crumb" aria-label="מיקום באתר">
    <a href="/">הבית</a>
    <span aria-hidden="true">/</span>
    <span><%= categoryNames[story.category] || story.category %></span>
  </nav>

  <header class="article-head">
    <h1><%= story.title %></h1>
    <p class="lede"><%= story.summary %></p>

    <p class="byline">
      <% if (story.reporter) { %><span class="who"><%= story.reporter.name %></span><span class="sep" aria-hidden="true">&middot;</span><% } %>
      <time datetime="<%= new Date(story.publishedAt).toISOString() %>"><%= day %></time>
      <span class="sep" aria-hidden="true">&middot;</span>
      <span><span id="views"><%= story.viewCount %></span> צפיות</span>
    </p>
  </header>

  <% if (story.image) { %>
    <figure class="hero"><img src="<%= story.image %>" alt="<%= story.title %>"></figure>
  <% } %>

  <div class="article-body">
    <% paragraphs.forEach((text) => { %><p><%= text %></p><% }) %>
  </div>

  <section class="comments" id="comments" aria-labelledby="comments-title">
    <h2 id="comments-title">תגובות (<span id="comment-count"><%= story.commentCount %></span>)</h2>

    <form id="comment-form" class="comment-form" novalidate>
      <div class="field">
        <label for="author">שם</label>
        <input id="author" name="author" type="text" maxlength="60" autocomplete="nickname" required>
      </div>
      <div class="field">
        <label for="text">תגובה</label>
        <textarea id="text" name="text" rows="4" maxlength="2000" required></textarea>
      </div>

      <p class="problem" id="form-problem" role="alert" hidden></p>

      <div class="actions">
        <button type="submit" id="send">פרסום תגובה</button>
      </div>
    </form>

    <div id="comments-loading" aria-live="polite">
      <div class="skeleton line"></div>
      <div class="skeleton line short"></div>
    </div>

    <div class="empty" id="comments-empty" hidden>
      <h2>עדיין אין תגובות</h2>
      <p>אפשר להיות הראשונים להגיב.</p>
    </div>

    <div class="notice bad" id="comments-problem" role="alert" hidden>
      <p id="comments-problem-text"></p>
      <button type="button" class="secondary" id="comments-retry">ניסיון חוזר</button>
    </div>

    <ol class="comment-list" id="comment-list"></ol>

    <div class="actions">
      <button type="button" class="secondary" id="more" hidden>תגובות נוספות</button>
    </div>
  </section>
</article>

<%- include('partials/bottom') %>
