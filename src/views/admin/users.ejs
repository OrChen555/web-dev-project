<%- include('../partials/top') %>

<h1>ניהול משתמשים</h1>
<p class="lede">חשבונות נוצרים כאן בלבד. אין הרשמה עצמית לאתר.</p>

<div class="with-panel">
  <section class="panel">
    <h2>חשבון חדש</h2>

    <form id="create" novalidate>
      <div class="field">
        <label for="username">שם משתמש</label>
        <input id="username" name="username" autocomplete="off" required>
      </div>

      <div class="field">
        <label for="name">שם מלא</label>
        <input id="name" name="name" autocomplete="off" required>
      </div>

      <div class="field">
        <label for="password">סיסמה</label>
        <input id="password" name="password" type="password" autocomplete="new-password" required>
        <span class="hint">לפחות שמונה תווים.</span>
      </div>

      <div class="field">
        <label for="role">תפקיד</label>
        <select id="role" name="role">
          <option value="reporter">כתב</option>
          <option value="editor">עורך</option>
        </select>
      </div>

      <!-- role="status" so that the result is announced rather than only seen.
           Both messages live here, and only one is ever showing. -->
      <p class="notice good" id="created" role="status" hidden></p>
      <p class="problem" id="problem" role="status" hidden></p>

      <div class="actions">
        <button type="submit">יצירה</button>
      </div>
    </form>
  </section>

  <section class="panel">
    <h2 class="sr-only">רשימת החשבונות</h2>

    <div class="scrolls">
      <table class="rows">
        <thead>
          <tr>
            <th>שם משתמש</th>
            <th>שם מלא</th>
            <th>תפקיד</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="rows"></tbody>
      </table>
    </div>
  </section>
</div>

<%- include('../partials/bottom') %>
