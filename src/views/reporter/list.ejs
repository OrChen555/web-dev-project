<%- include('../partials/top') %>

<h1>ניהול כתבות</h1>

<p class="actions">
  <button type="button" id="new">כתבה חדשה</button>
</p>

<div class="toolbar">
  <div class="field">
    <label for="status">מצב</label>
    <select id="status">
      <option value="">הכל</option>
      <option value="draft">בהכנה</option>
      <option value="pending">ממתינה לאישור</option>
      <option value="returned">הוחזרה לתיקונים</option>
    </select>
  </div>
</div>

<p class="problem" id="problem" role="status" hidden></p>

<div class="cards" id="rows"></div>

<!-- In the markup rather than built in JS, so the screen has something before
     the first response arrives. -->
<div class="cards" id="loading">
  <article class="card">
    <div class="thumb skeleton block"></div>
    <div>
      <div class="skeleton line"></div>
      <div class="skeleton line"></div>
      <div class="skeleton line short"></div>
    </div>
  </article>
  <article class="card">
    <div class="thumb skeleton block"></div>
    <div>
      <div class="skeleton line"></div>
      <div class="skeleton line"></div>
      <div class="skeleton line short"></div>
    </div>
  </article>
</div>

<div class="empty" id="empty" hidden>
  <h2>אין כאן כתבות</h2>
  <p>נסו לשנות את הסינון, או להתחיל לכתוב.</p>
</div>

<!-- What the observer watches: reaching it fetches the next page. -->
<div id="sentinel" aria-hidden="true"></div>

<!-- Its own dialog rather than site.confirm, which is text only. The category is
     asked for up front because it cannot be changed once the article exists. -->
<dialog id="pick" aria-labelledby="pick-title">
  <h2 id="pick-title">כתבה חדשה</h2>
  <p>הקטגוריה נקבעת עכשיו ולא ניתן לשנות אותה אחר כך.</p>

  <div class="field">
    <label for="pick-category">קטגוריה</label>
    <select id="pick-category">
      <% const NAMES = { news: 'חדשות', politics: 'פוליטיקה', economy: 'כלכלה', sports: 'ספורט', culture: 'תרבות', technology: 'טכנולוגיה', health: 'בריאות' }; %>
      <% for (const value of categories) { %>
        <option value="<%= value %>"><%= NAMES[value] || value %></option>
      <% } %>
    </select>
  </div>

  <p class="problem" id="pick-problem" role="status" hidden></p>

  <div class="actions">
    <button type="button" id="pick-go">יצירה</button>
    <button type="button" class="secondary" id="pick-no">ביטול</button>
  </div>
</dialog>

<%- include('../partials/bottom') %>
