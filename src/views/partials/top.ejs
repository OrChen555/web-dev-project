<!doctype html>
<html lang="he" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= locals.title || 'חדשות' %> &middot; The Daily Web</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Assistant:wght@400;500;600;700&family=Rubik:wght@500;600;700&display=swap">
  <link rel="stylesheet" href="/css/tokens.css">
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/components.css">

  <!-- Runs before the body is painted, so a reader who chose dark does not get
       a white page for the first frame. It is inline for that reason: a file
       would arrive too late. -->
  <script>
    try {
      var picked = localStorage.getItem('theme');
      if (picked) document.documentElement.dataset.theme = picked;
    } catch (e) {}

    // The theme button does nothing without site.js, and a control that looks
    // live but is not is worse than no control. This class is what reveals it,
    // and it is set here rather than in site.js so the button never appears and
    // then vanishes.
    document.documentElement.classList.add('js');
  </script>
</head>
<body>
  <header class="masthead">
    <!-- The wordmark is a background image rather than an <img> so that only the
         variant actually in use is downloaded. Two <img> tags would fetch both,
         and a <picture> can follow the system preference but not the toggle. -->
    <a class="wordmark" href="/">
      <span class="logo"></span>
      <span class="sr-only">The Daily Web</span>
    </a>

    <nav>
      <a href="/">הבית</a>

      <% if (typeof user !== 'undefined' && user) { %>
        <% if (user.isAdmin) { %><a href="/admin/users">ניהול משתמשים</a><% } %>
        <span class="whoami"><%= user.name %></span>
        <button type="button" class="quiet" id="logout">יציאה</button>
      <% } else { %>
        <a href="/login">כניסה</a>
      <% } %>

      <button type="button" class="icon-button theme-toggle" id="theme" aria-pressed="false" aria-label="מצב כהה">
        <svg class="sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg class="moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
        </svg>
      </button>
    </nav>
  </header>
  <main>
