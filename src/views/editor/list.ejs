<%- include('../partials/top') %>

<!-- Editor list (/editor/articles): the "אזור העורך" heading and the "סטטיסטיקות צפייה" button to /editor/analytics. -->
<div class="row between">
  <h1>אזור העורך</h1>
  <a class="button secondary" href="/editor/analytics">סטטיסטיקות צפייה</a>
</div>
<p class="lede">כל הכתבות במערכת, של כל הכתבים. כתבה שממתינה לאישור נפתחת לסקירה, עריכה, אישור או החזרה לתיקונים.</p>

<%# The options of the "מצב" dropdown, e.g. "ממתינות לאישור". %>
<% const LABELS = {
  all: 'הכל',
  pending: 'ממתינות לאישור',
  update: 'עדכונים לכתבות שפורסמו',
  draft: 'בהכנה',
  returned: 'הוחזרו לתיקונים',
  published: 'פורסמו'
}; %>

<!-- The filters bar: "מצב", "קטגוריה", "חיפוש לפי כותרת", "מיון". editor-list.js reloads the table on any change. -->
<form class="toolbar" id="filters" role="search">
  <div class="field">
    <label for="status">מצב</label>
    <%# The server picks the starting state (from ?status=), so the right option is selected on load. %>
    <select id="status" name="status">
      <% for (const value of ['all', 'pending', 'update', 'draft', 'returned', 'published']) { %>
        <option value="<%= value %>" <%= value === status ? 'selected' : '' %>><%= LABELS[value] %></option>
      <% } %>
    </select>
  </div>

  <%# "קטגוריה" dropdown, starting with "כל הקטגוריות". %>
  <div class="field">
    <label for="category">קטגוריה</label>
    <select id="category" name="category">
      <option value="">כל הקטגוריות</option>
      <% for (const value of categories) { %>
        <option value="<%= value %>"><%= categoryNames[value] || value %></option>
      <% } %>
    </select>
  </div>

  <%# "חיפוש לפי כותרת" box, takes the remaining width. %>
  <div class="field grow">
    <label for="q">חיפוש לפי כותרת</label>
    <input id="q" name="q" type="search" autocomplete="off" maxlength="100">
  </div>

  <%# "מיון" dropdown: "שינוי אחרון" or "הכי נצפות". %>
  <div class="field">
    <label for="sort">מיון</label>
    <select id="sort" name="sort">
      <option value="updated">שינוי אחרון</option>
      <option value="popular">הכי נצפות</option>
    </select>
  </div>
</form>

<!-- The error line above the table, e.g. "אין חיבור לשרת." Hidden until a request fails. -->
<p class="problem" id="problem" role="status" hidden></p>

<!-- The articles table ("כותרת", "כתב", "קטגוריה", "מצב" ...). Rows come from editor-list.js, 20 at a time. -->
<div class="scrolls">
  <table class="rows queue">
    <thead>
      <tr>
        <th>כותרת</th>
        <th>כתב</th>
        <th>קטגוריה</th>
        <th>מצב</th>
        <th>שינוי אחרון</th>
        <th>צפיות</th>
        <!-- A label rather than an .sr-only span: that one is absolutely
             positioned, escapes the scrolling box and widened the whole page
             on a phone. -->
        <th aria-label="פעולות"></th>
      </tr>
    </thead>
    <tbody id="rows"></tbody>
  </table>
</div>

<!-- In the markup rather than built in JS, so the screen has something before
     the first response arrives. -->
<div id="loading" aria-hidden="true">
  <div class="skeleton line"></div>
  <div class="skeleton line"></div>
  <div class="skeleton line short"></div>
</div>

<!-- "אין כתבות שמתאימות לסינון": shown when the filters match nothing. -->
<div class="empty" id="empty" hidden>
  <h2>אין כתבות שמתאימות לסינון</h2>
  <p>נסו מצב אחר, קטגוריה אחרת או חיפוש אחר.</p>
</div>

<!-- What the observer watches: reaching it fetches the next page. -->
<div id="sentinel" aria-hidden="true"></div>

<%- include('../partials/bottom') %>
