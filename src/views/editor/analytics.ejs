<%- include('../partials/top') %>

<!-- Two views of one page. Picking a card swaps the grid for that article's
     chart, and the back button (on the page or in the browser) swaps it back.
     The id in the address bar is what decides which one shows. -->

<section id="browse" aria-labelledby="browse-title">
  <h1 id="browse-title">סטטיסטיקות צפייה</h1>
  <p class="lede">בחרו כתבה כדי לראות את הצפיות בה לאורך זמן, ואיך כל עדכון שפורסם השפיע עליהן.</p>

  <form class="toolbar" id="find" role="search">
    <div class="field grow">
      <label for="q">חיפוש לפי כותרת</label>
      <input id="q" type="search" autocomplete="off" maxlength="100">
    </div>
    <p class="muted">כתבות שפורסמו, הנצפות ביותר קודם.</p>
  </form>

  <p class="problem" id="picker-problem" role="status" hidden></p>
  <ul class="choices" id="choices"></ul>

  <div class="choices" id="picker-loading" aria-hidden="true">
    <div class="skeleton block"></div>
    <div class="skeleton block"></div>
    <div class="skeleton block"></div>
  </div>

  <div class="empty" id="picker-empty" hidden>
    <h2>אין כתבות שפורסמו בשם הזה</h2>
    <p>נסו מילה אחרת מהכותרת.</p>
  </div>

  <!-- What the observer watches: reaching it fetches the next cards. -->
  <div id="sentinel" aria-hidden="true"></div>
</section>

<!-- The article picked in a link from elsewhere, so the page opens on its chart. -->
<section id="report" data-selected="<%= selected %>" aria-live="polite" hidden>
  <p class="crumb"><button type="button" class="quiet" id="back">&rarr; כל הכתבות</button></p>

  <div class="panel">
    <div class="row between">
      <div>
        <h1 id="report-title"></h1>
        <p class="byline" id="report-meta"></p>
      </div>
      <a class="button secondary" id="report-link" href="#">לסקירת הכתבה</a>
    </div>

    <div class="segmented" role="group" aria-label="טווח זמן">
      <button type="button" class="secondary" data-range="24h" aria-pressed="false">24 שעות</button>
      <button type="button" class="secondary" data-range="7d" aria-pressed="false">7 ימים</button>
      <button type="button" class="secondary" data-range="30d" aria-pressed="false">30 יום</button>
      <button type="button" class="secondary" data-range="all" aria-pressed="true">כל חיי הכתבה</button>
    </div>

    <p class="problem" id="chart-problem" role="status" hidden></p>

    <div class="chart-box">
      <canvas id="chart" role="img" aria-label="גרף הצפיות בכתבה לאורך זמן"></canvas>
    </div>
    <p class="muted" id="chart-caption"></p>

    <h2>לפני ואחרי כל פרסום</h2>
    <p class="muted" id="impact-hint"></p>
    <div class="scrolls">
      <table class="rows">
        <thead>
          <tr>
            <th>מועד</th>
            <th>מה פורסם</th>
            <th>צפיות לפני</th>
            <th>צפיות אחרי</th>
            <th>לשעה לפני</th>
            <th>לשעה אחרי</th>
            <th>שינוי</th>
          </tr>
        </thead>
        <tbody id="impact"></tbody>
      </table>
    </div>
    <p class="muted" id="impact-empty" hidden>לא היו פרסומים בטווח הזמן שנבחר.</p>
  </div>
</section>

<%- include('../partials/bottom') %>
